# Copie para .env (local) ou defina no Railway → Variables
API_KEY=troque-por-uma-chave-longa        # protege /v1/*; a UI e /usar ficam abertos
SUPERSONIC_MODEL=supertonic-3
DEFAULT_LANG=pt
MAX_TEXT_CHARS=40000
MAX_UPLOAD_MB=60
# Transcrição (só se instalou requirements-transcribe.txt)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Links do YouTube a partir do servidor (o YouTube bloqueia IPs de nuvem).
# Use UM dos dois (ou ambos):
# YTDLP_COOKIES_B64=<conteúdo do cookies.txt em base64, de uma conta Google secundária>
# YTDLP_PROXY=http://usuario:senha@host:porta   # proxy residencial; usado só pelo yt-dlp
